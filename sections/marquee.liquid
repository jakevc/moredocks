{{ 'moredocks-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .md-marquee-{{ section.id }} {
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(var(--color-foreground), 0.15);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.15);
    padding: {{ section.settings.padding_vertical }}px 0;
  }
  .md-marquee-{{ section.id }} .md-marquee__track {
    display: inline-block;
    animation: md-marquee-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
  }
  .md-marquee-{{ section.id }} .md-marquee__item {
    display: inline-block;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.text_size }}rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0 2.4rem;
  }
  .md-marquee-{{ section.id }} .md-marquee__sep {
    display: inline-block;
    opacity: 0.45;
  }
  @keyframes md-marquee-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .md-marquee-{{ section.id }} .md-marquee__track { animation: none; }
  }
{%- endstyle -%}

<div class="md-marquee-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="md-marquee__track" aria-hidden="false">
    {%- for i in (1..2) -%}
      <span {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="md-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span
          ><span class="md-marquee__sep">&#9671;</span>
        {%- endfor -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "label": "Scroll duration",
      "default": 35
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 1.2,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Text size",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Phrase",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made to order"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "phrase", "settings": { "text": "Made to order" } },
        { "type": "phrase", "settings": { "text": "Portland, Oregon" } },
        { "type": "phrase", "settings": { "text": "American garments" } }
      ]
    }
  ]
}
{% endschema %}
