{{ 'moredocks-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .md-rail-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .md-rail-{{ section.id }} .md-rail__head {
    padding: 0 4rem 2.4rem;
  }
  .md-rail-{{ section.id }} .md-rail__head h2 { margin: 0; }
  .md-rail-{{ section.id }} .md-rail__track {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .md-rail-{{ section.id }} .md-rail__track::-webkit-scrollbar { display: none; }
  .md-rail-{{ section.id }} .md-rail__item {
    flex: 0 0 auto;
    width: 72vw;
    scroll-snap-align: start;
  }
  /* Narrower than an exact 1/per_view share so the next photo peeks in and the
     row reads as scrollable — the old math left a 0.8rem gap and no peek. */
  @media screen and (min-width: 750px) {
    .md-rail-{{ section.id }} .md-rail__item { width: calc(100vw / {{ section.settings.per_view }} - 2.4rem); }
  }
  /* Visible focus ring when the track is tabbed to. */
  .md-rail-{{ section.id }} .md-rail__track:focus-visible {
    outline: 2px solid rgba(var(--color-foreground), 0.6);
    outline-offset: -2px;
  }
  .md-rail-{{ section.id }} .md-rail__item img,
  .md-rail-{{ section.id }} .md-rail__item svg {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
    height: auto;
    display: block;
  }
{%- endstyle -%}

{%- liquid
  assign per_view_vw = 100 | divided_by: section.settings.per_view
  capture sizes_attr
    echo '(min-width: 750px) '
    echo per_view_vw
    echo 'vw, 72vw'
  endcapture
-%}

<div class="md-rail-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <div class="md-rail__head"><h2>{{ section.settings.heading | escape }}</h2></div>
  {%- endif -%}
  <div
    class="md-rail__track"
    role="list"
    tabindex="0"
    aria-label="{{ section.settings.heading | default: 'Photographs' | escape }}"
  >
    {%- for block in section.blocks -%}
      <div class="md-rail__item" role="listitem" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.alt, sizes: sizes_attr, widths: '600, 900, 1200' }}
        {%- elsif block.settings.asset_image != blank -%}
          <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.alt | default: 'Moredocks' | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Photo rail",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "range",
      "id": "per_view",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Photos per view (desktop)",
      "default": 4
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_image", "label": "Theme asset filename (fallback)" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Photo rail",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
