{{ 'moredocks-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .md-quotes-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 4rem {{ section.settings.padding_bottom }}px;
  }
  .md-quotes-{{ section.id }} .md-quotes__heading {
    margin: 0 0 3.6rem;
  }
  .md-quotes-{{ section.id }} .md-quotes__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem 2.4rem;
  }
  @media screen and (min-width: 750px) {
    .md-quotes-{{ section.id }} .md-quotes__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }
  .md-quotes-{{ section.id }} .md-quote figure { margin: 0; }
  .md-quotes-{{ section.id }} .md-quote__img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
    display: block;
    margin-bottom: 1.6rem;
  }
  .md-quotes-{{ section.id }} .md-quote blockquote {
    font-family: var(--font-heading-family);
    font-size: 1.9rem;
    line-height: 1.35;
    margin: 0 0 1.2rem;
    border: 0;
    padding: 0;
  }
  .md-quotes-{{ section.id }} .md-quote cite {
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 1.1rem;
    opacity: 0.7;
  }
  .md-quotes-{{ section.id }} .md-quote cite a { color: inherit; }
{%- endstyle -%}

<div class="md-quotes-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <h2 class="md-quotes__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="md-quotes__grid">
    {%- for block in section.blocks -%}
      <div class="md-quote" {{ block.shopify_attributes }}>
        <figure>
          {%- if block.settings.show_image and block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'md-quote__img', sizes: '(min-width: 750px) 25vw, 100vw', widths: '450, 700, 900' }}
          {%- endif -%}
          <blockquote>{{ block.settings.quote }}</blockquote>
          {%- if block.settings.author != blank -%}
            <cite>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.author | escape }}</a>
              {%- else -%}
                {{ block.settings.author | escape }}
              {%- endif -%}
            </cite>
          {%- endif -%}
        </figure>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn & reviewed" },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "url", "id": "link", "label": "Author link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
