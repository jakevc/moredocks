{{ 'moredocks-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .md-spot-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media screen and (min-width: 990px) {
    .md-spot-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      min-height: 80vh;
    }
    .md-spot-{{ section.id }}.md-spot--reverse .md-spot__media { order: 2; }
    .md-spot-{{ section.id }}.md-spot--reverse .md-spot__content { order: 1; }
  }
  .md-spot-{{ section.id }} .md-spot__media {
    position: relative;
    overflow: hidden;
    min-height: 50vh;
  }
  .md-spot-{{ section.id }} .md-spot__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .md-spot-{{ section.id }} .md-spot__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 3rem;
  }
  @media screen and (min-width: 990px) {
    .md-spot-{{ section.id }} .md-spot__content { padding: 8rem 10%; }
  }
  .md-spot-{{ section.id }} .md-spot__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 1.1rem;
    opacity: 0.7;
    margin: 0 0 1.6rem;
  }
  .md-spot-{{ section.id }} .md-spot__heading {
    font-size: calc(var(--font-heading-scale) * 3.4rem);
    line-height: 1.05;
    margin: 0 0 2rem;
  }
  .md-spot-{{ section.id }} .md-spot__text {
    max-width: 44ch;
    margin: 0 0 1.2rem;
  }
  .md-spot-{{ section.id }} .md-spot__price {
    font-family: var(--font-heading-family);
    font-size: 1.7rem;
    letter-spacing: 0.08em;
    margin: 0 0 2.8rem;
  }
  .md-spot-{{ section.id }} .md-spot__cta { align-self: flex-start; }
{%- endstyle -%}

{%- liquid
  assign product = section.settings.product
  assign img = section.settings.image
  if img == blank and section.settings.asset_image == blank and product != blank
    assign img = product.featured_image
  endif
-%}

<div class="md-spot-{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.reverse %} md-spot--reverse{% endif %}">
  <div class="md-spot__media">
    {%- if img != blank -%}
      {{ img | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '750, 1100, 1500, 2000' }}
    {%- elsif section.settings.asset_image != blank -%}
      <img src="{{ section.settings.asset_image | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="md-spot__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="md-spot__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="md-spot__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="md-spot__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if product != blank -%}
      <p class="md-spot__price">{{ product.price | money }}</p>
    {%- endif -%}
    {%- liquid
      assign cta_url = section.settings.button_link
      if cta_url == blank and product != blank
        assign cta_url = product.url
      endif
    -%}
    {%- if section.settings.button_label != blank and cta_url != blank -%}
      <a href="{{ cta_url }}" class="button md-spot__cta">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the theme asset below, then the product's featured image." },
    { "type": "text", "id": "asset_image", "label": "Theme asset filename", "info": "e.g. md-spot-jean.jpg — used when no image is selected above. Takes precedence over the product photo so editorial shots aren't replaced by catalogue cutouts." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Cowboy Jean" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Falls back to the product page." },
    { "type": "checkbox", "id": "reverse", "label": "Image on right (desktop)", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Editorial spotlight" }]
}
{% endschema %}
